/**
 * openfl's blend modes. Scripts pass them by name ("add", "multiply"), and Psych
 * resolves the string through FlxSprite's setBlendMode.
 */
extern class BlendMode {
	public static var ADD:Dynamic;
	public static var ALPHA:Dynamic;
	public static var DARKEN:Dynamic;
	public static var DIFFERENCE:Dynamic;
	public static var ERASE:Dynamic;
	public static var HARDLIGHT:Dynamic;
	public static var INVERT:Dynamic;
	public static var LAYER:Dynamic;
	public static var LIGHTEN:Dynamic;
	public static var MULTIPLY:Dynamic;
	public static var NORMAL:Dynamic;
	public static var OVERLAY:Dynamic;
	public static var SCREEN:Dynamic;
	public static var SHADER:Dynamic;
	public static var SUBTRACT:Dynamic;
}
