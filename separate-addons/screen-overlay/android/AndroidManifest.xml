<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.zyn.lightengine.overlay" android:versionCode="1" android:versionName="1.0">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <application android:label="Light Engine Image Overlay" android:allowBackup="false"
        android:supportsRtl="true" android:usesCleartextTraffic="false"
        android:icon="@android:drawable/ic_menu_gallery"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".OverlayActivity" android:exported="true" android:launchMode="singleTask" android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="lightengine-overlay" />
            </intent-filter>
        </activity>
        <service android:name=".OverlayService" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="A user-approved PNG image displayed above home and other apps, with a close button and foreground Stop control." />
        </service>
    </application>
</manifest>
